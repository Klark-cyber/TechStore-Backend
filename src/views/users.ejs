<%- include('includes/header') %>

<!DOCTYPE html>
<html class="light" lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>User Directory | TechStore Admin</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
<script id="tailwind-config">
  tailwind.config = {
    darkMode: "class",
    theme: {
      extend: {
        colors: {
          "primary": "#0066FF",
          "background": "#FFFFFF",
          "surface": "#F8FAFC",
          "outline": "#E2E8F0",
          "on-surface": "#1E293B",
          "on-surface-variant": "#64748B"
        },
        fontFamily: {
          "sans": ["Inter", "sans-serif"]
        }
      }
    }
  }
</script>
<style>
  body { font-family: 'Inter', sans-serif; }
  .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
</style>
</head>
<body class="bg-white text-on-surface min-h-screen">

<% if (!member) { %>

<!-- Login kerak -->
<nav class="bg-white border-b border-outline fixed top-0 w-full z-50 flex justify-between items-center px-8 h-16">
  <div class="text-xl font-bold text-slate-900 tracking-tight">TechStore Admin</div>
  <div class="hidden md:flex items-center gap-8">
    <a class="text-on-surface-variant font-medium hover:text-primary transition-colors" href="/admin/">Home</a>
    <a class="text-on-surface-variant font-medium hover:text-primary transition-colors" href="/admin/signup">SignUp</a>
    <a class="text-on-surface-variant font-medium hover:text-primary transition-colors" href="/admin/login">Login</a>
  </div>
</nav>
<main class="pt-24 pb-12 px-6 flex items-center justify-center min-h-screen">
  <div class="text-4xl font-bold text-slate-400">Please login first!</div>
</main>

<% } else { %>

<!-- Logged in -->
<nav class="bg-white border-b border-outline fixed top-0 w-full z-50 flex justify-between items-center px-8 h-16">
  <div class="text-xl font-bold text-slate-900 tracking-tight">TechStore Admin</div>
  <div class="hidden md:flex items-center gap-8">
    <a class="text-on-surface-variant font-medium hover:text-primary transition-colors" href="/admin/">Home</a>
    <a class="text-on-surface-variant font-medium hover:text-primary transition-colors" href="/admin/product/all">Menu</a>
    <a class="text-primary font-bold border-b-2 border-primary" href="/admin/user/all">Users</a>
    <a class="text-on-surface-variant font-medium hover:text-primary transition-colors"
      href="/admin/logout"
      onclick="return confirm('Do you really want to logout?')">Logout</a>
  </div>
  <div class="flex items-center gap-4">
    <button class="material-symbols-outlined text-on-surface-variant hover:text-primary transition-all p-2">notifications</button>
    <button class="material-symbols-outlined text-on-surface-variant hover:text-primary transition-all p-2">settings</button>
  </div>
</nav>

<main class="pt-24 pb-12 px-6 md:px-12 max-w-7xl mx-auto">

  <!-- Header -->
  <div class="mb-10">
    <h1 class="text-4xl font-extrabold tracking-tight text-on-surface mb-2">All Users List</h1>
    <p class="text-on-surface-variant font-medium">Manage and monitor system access for all registered members.</p>
  </div>

  <!-- Summary Stats -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
    <div class="bg-primary text-white p-6 rounded-xl shadow-md relative overflow-hidden">
      <div class="relative z-10">
        <div class="flex justify-between items-start mb-4">
          <span class="material-symbols-outlined text-3xl">group</span>
          <span class="text-[10px] font-bold uppercase tracking-widest bg-white/20 px-2 py-0.5 rounded">Live Data</span>
        </div>
        <div class="text-4xl font-black mb-1"><%= users.length %></div>
        <div class="text-sm font-medium opacity-90">Total Active Registered Members</div>
      </div>
    </div>
    <div class="bg-surface p-6 rounded-xl border border-outline shadow-sm flex flex-col justify-center">
      <div class="text-on-surface-variant text-xs font-bold mb-2 uppercase tracking-wide">System Health</div>
      <div class="flex items-center gap-3">
        <div class="text-2xl font-bold text-on-surface">Optimized</div>
        <div class="relative flex h-3 w-3">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-3 w-3 bg-green-500"></span>
        </div>
      </div>
    </div>
    <div class="bg-surface p-6 rounded-xl border border-outline shadow-sm flex flex-col justify-center">
      <div class="text-on-surface-variant text-xs font-bold mb-2 uppercase tracking-wide">Sync Status</div>
      <div class="text-3xl font-black text-on-surface tabular-nums" id="digital-clock">00:00:00</div>
      <div class="text-xs font-medium text-on-surface-variant flex items-center gap-1">
        <span class="w-2 h-2 rounded-full bg-blue-500"></span> Real-time
      </div>
    </div>
  </div>

  <!-- User Table -->
  <div class="bg-white rounded-xl border border-outline shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-slate-50 border-b border-outline">
            <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-on-surface-variant">No</th>
            <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-on-surface-variant">Name</th>
            <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-on-surface-variant">Phone</th>
            <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-on-surface-variant">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-outline">
          <% users.map(function(value, index) { %>
          <tr class="hover:bg-slate-50 transition-colors">
            <td class="px-6 py-5">
              <span class="text-on-surface-variant font-medium"><%= index + 1 %></span>
            </td>
            <td class="px-6 py-5">
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-full bg-blue-100 flex items-center justify-center text-primary font-bold text-sm">
                  <%= value.memberNick.charAt(0).toUpperCase() %>
                </div>
                <span class="font-semibold text-on-surface"><%= value.memberNick %></span>
              </div>
            </td>
            <td class="px-6 py-5 text-on-surface-variant"><%= value.memberPhone %></td>
            <td class="px-6 py-5">
              <select class="member-status bg-white border border-outline rounded-lg text-sm font-medium px-3 py-1.5 focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none cursor-pointer transition-all w-32" id="<%= value._id %>">
                <option value="ACTIVE" <%= value.memberStatus === "ACTIVE" ? "selected" : "" %>>ACTIVE</option>
                <option value="BLOCK" <%= value.memberStatus === "BLOCK" ? "selected" : "" %>>BLOCK</option>
                <option value="DELETE" <%= value.memberStatus === "DELETE" ? "selected" : "" %>>DELETE</option>
              </select>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>

</main>

<% } %>

<script src="/js/users.js" type="text/javascript"></script>
<script>
  function updateClock() {
    var now = new Date();
    var hours = String(now.getHours()).padStart(2, '0');
    var minutes = String(now.getMinutes()).padStart(2, '0');
    var seconds = String(now.getSeconds()).padStart(2, '0');
    var el = document.getElementById('digital-clock');
    if (el) el.textContent = hours + ':' + minutes + ':' + seconds;
  }
  setInterval(updateClock, 1000);
  updateClock();
</script>

</body>
</html>

<%- include('includes/footer') %>