<form action="/admin/product/create" class="p-8 overflow-y-auto" enctype="multipart/form-data" method="POST">
<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
<!-- Basic Info -->
<div class="space-y-6">
<div class="space-y-1">
<label class="text-xs font-bold text-slate-500 uppercase tracking-widest">Product Name</label>
<input class="w-full bg-slate-50 border-0 border-b-2 border-slate-200 focus:border-blue-600 focus:ring-0 text-slate-900 py-3 transition-all rounded-t-lg" name="productName" required="" type="text"/>
</div>
<div class="space-y-1">
<label class="text-xs font-bold text-slate-500 uppercase tracking-widest">Category Type</label>
<select class="w-full bg-slate-50 border-0 border-b-2 border-slate-200 focus:border-blue-600 focus:ring-0 text-slate-900 py-3 transition-all rounded-t-lg" id="productType" name="productCollection" onchange="toggleSpecFields()" required="">
<option value="OTHER">Other</option>
<option value="TELEPHONE">Telephone</option>
<option value="ACCESSORY">Accessory</option>
</select>
</div>
<div class="hidden grid grid-cols-2 gap-4 animate-in fade-in duration-300" id="specFields">
<div class="space-y-1">
<label class="text-xs font-bold text-slate-500 uppercase tracking-widest">RAM</label>
<input class="w-full bg-slate-50 border-0 border-b-2 border-slate-200 focus:border-blue-600 focus:ring-0 text-slate-900 py-3 transition-all rounded-t-lg" name="ram" placeholder="e.g. 8GB" type="text"/>
</div>
<div class="space-y-1">
<label class="text-xs font-bold text-slate-500 uppercase tracking-widest">Storage</label>
<input class="w-full bg-slate-50 border-0 border-b-2 border-slate-200 focus:border-blue-600 focus:ring-0 text-slate-900 py-3 transition-all rounded-t-lg" name="memory" placeholder="e.g. 256GB" type="text"/>
</div>
</div>
<div class="grid grid-cols-2 gap-4">
<div class="space-y-1">
<label class="text-xs font-bold text-slate-500 uppercase tracking-widest">Price ($)</label>
<input class="w-full bg-slate-50 border-0 border-b-2 border-slate-200 focus:border-blue-600 focus:ring-0 text-slate-900 py-3 transition-all rounded-t-lg" name="price" required="" step="0.01" type="number"/>
</div>
<div class="space-y-1">
<label class="text-xs font-bold text-slate-500 uppercase tracking-widest">Inventory Count</label>
<input class="w-full bg-slate-50 border-0 border-b-2 border-slate-200 focus:border-blue-600 focus:ring-0 text-slate-900 py-3 transition-all rounded-t-lg" name="count" required="" type="number"/>
</div>
</div>
</div>
<!-- Media & Desc -->
<div class="space-y-6">
<div class="space-y-1">
<label class="text-xs font-bold text-slate-500 uppercase tracking-widest">Visual Description</label>
<textarea class="w-full bg-slate-50 border-0 border-b-2 border-slate-200 focus:border-blue-600 focus:ring-0 text-slate-900 py-3 transition-all rounded-t-lg resize-none" name="desc" rows="4"></textarea>
</div>
<div class="space-y-3">
<label class="text-xs font-bold text-slate-500 uppercase tracking-widest">Product Imagery</label>
<div class="border-2 border-dashed border-slate-200 rounded-xl p-8 flex flex-col items-center justify-center bg-slate-50 hover:bg-white hover:border-blue-500 transition-all cursor-pointer relative group">
<span class="material-symbols-outlined text-4xl text-slate-300 mb-2 group-hover:text-blue-600 transition-colors" data-icon="cloud_upload">cloud_upload</span>
<span class="text-sm text-slate-500">Click or drag images to upload</span>
<input class="absolute inset-0 opacity-0 cursor-pointer" multiple="" name="images" onchange="previewImages(event)" type="file"/>
</div>
<div class="grid grid-cols-4 gap-2 mt-4" id="imageGrid">
<!-- Previews injected here -->
</div>
</div>
</div>
</div>
<div class="mt-12 flex justify-end gap-4 border-t border-slate-100 pt-8">
<button class="px-8 py-3 text-slate-500 font-bold hover:text-slate-900 transition-colors uppercase tracking-widest text-xs" onclick="document.getElementById('productModal').classList.add('hidden')" type="button">Discard</button>
<button class="bg-blue-600 hover:bg-blue-700 text-white px-10 py-3 rounded-lg font-bold shadow-lg shadow-blue-500/20 active:scale-95 transition-all" type="submit">
                        Execute Creation
                    </button>
</div>
