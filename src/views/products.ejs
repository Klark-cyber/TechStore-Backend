<!-- Logic for Form Behavior -->
<script>
        const categorySelect = document.getElementById('categorySelect');
        const memoryContainer = document.getElementById('memoryContainer');

        categorySelect.addEventListener('change', (e) => {
            if (e.target.value === 'TELEPHONE') {
                memoryContainer.style.opacity = '1';
                memoryContainer.style.pointerEvents = 'auto';
                memoryContainer.classList.remove('grayscale', 'opacity-30');
            } else {
                memoryContainer.style.opacity = '0.3';
                memoryContainer.style.pointerEvents = 'none';
                memoryContainer.classList.add('grayscale');
            }
        });
    </script>
