<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>TechStore Admin — Products</title>
  <link rel="stylesheet" href="/css/products.css" />
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
</head>
<body>

  <!-- ── SIDEBAR ── -->
  <aside id="sidebar" class="sidebar">
    <div class="sidebar-logo">
      <div class="sidebar-logo-icon">
        <span class="material-symbols-outlined">bolt</span>
      </div>
      <div>
        <div class="sidebar-title">TECH<span>STORE</span></div>
        <div class="sidebar-sub">Management Portal</div>
      </div>
    </div>

    <nav class="sidebar-nav">
      <a href="/admin/" class="nav-link">
        <span class="material-symbols-outlined">home</span> Home
      </a>
      <a href="/admin/product/all" class="nav-link active">
        <span class="material-symbols-outlined">inventory_2</span> Products
      </a>
      <a href="/admin/user/all" class="nav-link">
        <span class="material-symbols-outlined">group</span> Users
      </a>
    </nav>

    <div class="sidebar-bottom">
      <button class="btn-add-product" onclick="showProductForm()">
        <span class="material-symbols-outlined">add</span> Add New Product
      </button>
      <a href="#" class="nav-link">
        <span class="material-symbols-outlined">help</span> Help Center
      </a>
      <a href="/admin/logout" class="nav-link danger"
        onclick="return confirm('Do you want to logout?')">
        <span class="material-symbols-outlined">logout</span> Logout
      </a>
    </div>
  </aside>

  <div id="sidebar-overlay" class="sidebar-overlay hidden" onclick="closeSidebar()"></div>

  <!-- ── TOPBAR ── -->
  <header class="topbar">
    <button class="menu-btn" onclick="toggleSidebar()">
      <span class="material-symbols-outlined">menu</span>
    </button>
    <div class="topbar-logo">
      <span class="material-symbols-outlined" style="color:#2979ff">bolt</span>
      TECH<span>STORE</span> Admin
    </div>
    <nav class="topbar-nav">
      <a href="/admin/">Home</a>
      <a href="/admin/product/all" class="active">Products</a>
      <a href="/admin/user/all">Users</a>
      <a href="/admin/logout" onclick="return confirm('Do you really want to logout?')">Logout</a>
    </nav>
  </header>

  <!-- ── MAIN ── -->
  <main class="main-content">

    <!-- ── CATALOG TABLE ── -->
    <section class="catalog-section" id="catalog-section">
      <div class="catalog-header">
        <div>
          <h1 class="catalog-title">Electronics Catalog</h1>
          <p class="catalog-sub">
            Manage your full electronics catalog and stock in one place.
            <% if (typeof products !== 'undefined') { %>
              — <strong><%= products.length %></strong> products
            <% } %>
          </p>
        </div>
        <div class="filter-bar">
          <div class="search-wrap">
            <span class="material-symbols-outlined search-icon">search</span>
            <input
              id="searchInput"
              value="<%= typeof search !== 'undefined' ? search : '' %>"
              class="search-input"
              placeholder="Filter by name..."
              type="text"
            />
          </div>
          <select id="categorySelect" class="category-select">
            <option value="">All Categories</option>
            <option value="TELEPHONE"    <%= typeof productCollection !== 'undefined' && productCollection === 'TELEPHONE'    ? 'selected' : '' %>>TELEPHONE</option>
            <option value="PC"           <%= typeof productCollection !== 'undefined' && productCollection === 'PC'           ? 'selected' : '' %>>PC</option>
            <option value="LAPTOPS"      <%= typeof productCollection !== 'undefined' && productCollection === 'LAPTOPS'      ? 'selected' : '' %>>LAPTOPS</option>
            <option value="MACBOOKS"     <%= typeof productCollection !== 'undefined' && productCollection === 'MACBOOKS'     ? 'selected' : '' %>>MACBOOKS</option>
            <option value="SMARTWATCHES" <%= typeof productCollection !== 'undefined' && productCollection === 'SMARTWATCHES' ? 'selected' : '' %>>SMARTWATCHES</option>
            <option value="ACCESSORIES"  <%= typeof productCollection !== 'undefined' && productCollection === 'ACCESSORIES'  ? 'selected' : '' %>>ACCESSORIES</option>
            <option value="OTHERS"       <%= typeof productCollection !== 'undefined' && productCollection === 'OTHERS'       ? 'selected' : '' %>>OTHERS</option>
          </select>
          <button onclick="searchProducts()" class="filter-btn">
            <span class="material-symbols-outlined">tune</span>
          </button>
        </div>
      </div>

      <div class="table-card">
        <div class="table-wrap">
          <table class="products-table">
            <thead>
              <tr>
                <th>No</th>
                <th>Product</th>
                <th>Brand</th>
                <th>Category</th>
                <th>Specs</th>
                <th>Price</th>
                <th>Stock</th>
                <th>Status</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% if (typeof products !== 'undefined' && products.length > 0) { %>
                <% products.forEach(function(product, index) { %>
                <tr>
                  <td class="td-no"><%= (index + 1).toString().padStart(2, '0') %></td>
                  <td>
                    <div class="product-cell">
                      <div class="product-thumb">
                        <% if (product.productImages && product.productImages.length > 0) { %>
                          <img src="/<%= product.productImages[0] %>" alt="" />
                        <% } else { %>
                          <span class="material-symbols-outlined" style="font-size:18px;opacity:0.4">image</span>
                        <% } %>
                      </div>
                      <span class="product-name"><%= product.productName %></span>
                    </div>
                  </td>
                  <td><%= product.productBrand || '—' %></td>
                  <td><span class="badge"><%= product.productCollection %></span></td>
                  <td class="td-specs">
                    <% if (['TELEPHONE','MACBOOKS','LAPTOPS','PC'].includes(product.productCollection)) { %>
                      <span>RAM: <%= product.productRam || '—' %></span>
                      <span>Storage: <%= product.productMemory || '—' %></span>
                    <% } else { %>—<% } %>
                  </td>
                  <td class="td-price">$<%= product.productPrice ? product.productPrice.toLocaleString() : '0' %></td>
                  <td class="td-stock">
                    <span class="stock-badge <%= product.productLeftCount > 10 ? 'in-stock' : product.productLeftCount > 0 ? 'low-stock' : 'out-stock' %>">
                      <%= product.productLeftCount %>
                    </span>
                  </td>
                  <td>
                    <select
                      id="<%= product._id %>"
                      onchange="updateProductStatus(this, event)"
                      onclick="event.stopPropagation()"
                      class="status-select status-<%= product.productStatus ? product.productStatus.toLowerCase() : 'process' %>"
                    >
                      <option value="ACTIVE"  <%= product.productStatus === 'ACTIVE'  ? 'selected' : '' %>>ACTIVE</option>
                      <option value="PAUSE"   <%= product.productStatus === 'PAUSE'   ? 'selected' : '' %>>PAUSE</option>
                      <option value="PROCESS" <%= product.productStatus === 'PROCESS' ? 'selected' : '' %>>PROCESS</option>
                      <option value="DELETE"  <%= product.productStatus === 'DELETE'  ? 'selected' : '' %>>DELETE</option>
                    </select>
                  </td>
                  <td class="td-action">
                    <span class="material-symbols-outlined">more_vert</span>
                  </td>
                </tr>
                <% }); %>
              <% } else { %>
              <tr>
                <td colspan="9" class="td-empty">
                  <span class="material-symbols-outlined" style="font-size:36px;opacity:0.3;display:block;margin-bottom:8px">inventory_2</span>
                  No products found in the catalog
                </td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <div class="table-footer">
          <% if (typeof products !== 'undefined') { %>
            Showing <strong><%= products.length %></strong> products
          <% } %>
        </div>
      </div>
    </section>

    <!-- ── GAP ── -->
    <div style="height: 48px;"></div>

    <!-- ── CREATE PRODUCT FORM ── -->
    <section class="form-section hidden" id="product-form-section">
      <div class="form-card">
        <div class="form-header">
          <div class="form-header-icon">
            <span class="material-symbols-outlined">add_circle</span>
          </div>
          <div>
            <h2 class="form-title">Create New Product</h2>
            <p class="form-sub">List a new electronic device or accessory in the store.</p>
          </div>
          <button type="button" class="form-close-btn" onclick="hideProductForm()">
            <span class="material-symbols-outlined">close</span>
          </button>
        </div>

        <form action="/admin/product/create" method="POST" enctype="multipart/form-data" onsubmit="return validateForm()">

          <div class="form-grid">
            <div class="form-group">
              <label>Product Name</label>
              <input name="productName" type="text" placeholder="e.g. Galaxy S24 Ultra" required />
            </div>
            <div class="form-group">
              <label>Brand</label>
              <input name="productBrand" type="text" placeholder="e.g. Samsung" required />
            </div>
            <div class="form-group">
              <label>Category</label>
              <select name="productCollection" id="productCollection" onchange="toggleSpecs()">
                <option value="TELEPHONE">TELEPHONE</option>
                <option value="PC">PC</option>
                <option value="LAPTOPS">LAPTOPS</option>
                <option value="MACBOOKS">MACBOOKS</option>
                <option value="SMARTWATCHES">SMARTWATCHES</option>
                <option value="ACCESSORIES">ACCESSORIES</option>
                <option value="OTHERS">OTHERS</option>
              </select>
            </div>
          </div>

          <div class="form-grid form-grid-2">
            <div class="form-group">
              <label>Price ($)</label>
              <input name="productPrice" type="number" placeholder="0.00" required />
            </div>
            <div class="form-group">
              <label>Initial Stock</label>
              <input name="productLeftCount" type="number" placeholder="0" required />
            </div>
          </div>

          <div id="telephone-specs" class="specs-block hidden">
            <div class="specs-header">
              <span class="material-symbols-outlined">settings_input_component</span>
              Product Specifications
            </div>
            <div class="form-grid form-grid-2">
              <div class="form-group">
                <label>RAM (GB)</label>
                <input name="productRam" type="number" placeholder="e.g. 8" disabled />
              </div>
              <div class="form-group">
                <label>Storage (GB)</label>
                <input name="productMemory" type="number" placeholder="e.g. 128" disabled />
              </div>
            </div>
          </div>

          <div class="form-group">
            <label>Description</label>
            <textarea name="productDesc" rows="4" placeholder="Describe the key features and benefits..."></textarea>
          </div>

          <div class="form-group">
            <label>Product Images <span class="label-hint">(at least 1 required)</span></label>
            <div class="img-grid">
              <% for(let i = 1; i <= 5; i++) { %>
              <div class="img-slot" data-idx="<%= i %>">
                <span class="material-symbols-outlined">add_a_photo</span>
                <span class="slot-label">Upload</span>
                <button type="button" class="slot-remove">✕</button>
              </div>
              <% } %>
            </div>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn-submit">Create Product Entry</button>
            <button type="button" class="btn-cancel" onclick="hideProductForm()">Cancel</button>
          </div>
        </form>
      </div>

      <div class="form-side">
        <div class="side-card">
          <div class="side-card-label">Sales Growth</div>
          <div class="side-card-value">+12.4%</div>
          <p class="side-card-desc">Our electronics catalog is growing fast — new products added weekly.</p>
          <span class="material-symbols-outlined side-card-icon">analytics</span>
        </div>
      </div>
    </section>

  </main>

  <script src="/js/products.js"></script>
</body>
</html>
