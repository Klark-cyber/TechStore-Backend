<span class="material-symbols-outlined text-4xl" data-icon="verified_user" data-weight="fill">verified_user</span>
<div>
<h3 class="text-xl font-bold mb-1">Secure Governance</h3>
<p class="text-primary-fixed/80 text-sm">Advanced RBAC and activity auditing for user ecosystems.</p>
</div>
</div>
<!-- Performance Grid -->
<div class="bento-card bg-surface-container-highest rounded-xl p-8 flex flex-col justify-center items-center text-center gap-4">
<span class="text-5xl font-black text-primary">99.9%</span>
<p class="text-xs font-bold uppercase tracking-widest text-on-surface-variant">System Uptime</p>
</div>
<!-- Global Nodes -->
<div class="md:col-span-2 bento-card bg-inverse-surface rounded-xl p-8 flex items-center justify-between">
<div class="space-y-4">
<h3 class="text-2xl font-bold text-inverse-on-surface">Global Distribution</h3>
<p class="text-slate-400 text-sm max-w-xs">Connecting your products to a worldwide network of warehouses and retail nodes.</p>
<button class="text-primary-container font-bold text-sm flex items-center gap-2">
                        View Network <span class="material-symbols-outlined text-sm" data-icon="open_in_new">open_in_new</span>
</button>
</div>
<div class="hidden sm:block w-48 h-32 bg-slate-800 rounded-lg overflow-hidden grayscale">
<img alt="World map nodes" class="w-full h-full object-cover opacity-50" data-alt="abstract digital world map with glowing blue connection lines between major global tech hubs" data-location="London" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBLZr5QgJFhMceDeSrxOZGLTUclkZsp864oG8zert_-7PqJlbQLFnq73gMpkBSUiizKKEy8vHeGIK6jroudg2VR8S_UGEpQel4k1Jpr9t4-MbfTKlzq3kWRvNpSjXqFABWFkeP_DgxNn8e8-q9m4H-5xV-Y7z2VKRk9aZWsYlIvv3CHzBjSmYIoJoYJrRn3mfdNJoWBUZPZKDNrujBReZHkCMXFObaaPCMCCFOgp401k4-pfLaJSIL0sCvm-oHWOowvvfI4cLp-z7Ck"/>
</div>
</div>
</div>
</section>
<!-- Footer -->
<footer class="w-full border-t border-slate-800/50 bg-slate-950 px-12 py-8 flex flex-col md:flex-row justify-between items-center gap-4">
<div class="flex items-center gap-4">
<span class="text-lg font-black text-slate-200">TechStore</span>
<span class="text-xs uppercase tracking-widest font-semibold text-slate-500">© 2024 TechStore. Kinetic Precision Engineering.</span>
</div>
<div class="flex gap-8">
<a class="text-xs uppercase tracking-widest font-semibold text-slate-500 hover:text-slate-300 transition-all duration-300 hover:text-blue-400 underline-offset-4 hover:underline" href="#">Privacy Policy</a>
<a class="text-xs uppercase tracking-widest font-semibold text-slate-500 hover:text-slate-300 transition-all duration-300 hover:text-blue-400 underline-offset-4 hover:underline" href="#">Terms of Service</a>
<a class="text-xs uppercase tracking-widest font-semibold text-slate-500 hover:text-slate-300 transition-all duration-300 hover:text-blue-400 underline-offset-4 hover:underline" href="#">Support</a>
<a class="text-xs uppercase tracking-widest font-semibold text-slate-500 hover:text-slate-300 transition-all duration-300 hover:text-blue-400 underline-offset-4 hover:underline" href="#">Contact</a>
