<style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .glass-nav {
            background: rgba(15, 23, 42, 0.8);
            backdrop-filter: blur(20px);
        }
        .hero-gradient {
            background: linear-gradient(135deg, #0f172a 0%, #001849 100%);
        }
        .floating-sphere {
            background: radial-gradient(circle at 30% 30%, #0066ff, #001849);
            box-shadow: 0 0 60px rgba(0, 102, 255, 0.3), inset -20px -20px 50px rgba(0,0,0,0.5);
        }
        .bento-card {
            transition: transform 0.3s ease, background-color 0.3s ease;
        }
        .bento-card:hover {
            transform: translateY(-4px);
        }
    </style>
</head>
<body class="bg-surface font-body text-on-surface selection:bg-primary-container selection:text-on-primary-container">
<!-- Top Navigation Bar -->
<nav class="fixed top-0 w-full z-50 glass-nav border-b border-white/5">
<div class="flex justify-between items-center px-6 py-4 max-w-7xl mx-auto">
<div class="flex items-center gap-3">
<img alt="TechStore Logo" class="h-8 w-auto" data-alt="minimalist futuristic tech logo with geometric shapes and neon blue accents on a dark background" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCvTCY4-WqaneGC-h_qtBLfD0E9XR44ckTccPbZzxYjJeO3FiUmToodnxYmY2IVFKxo_ccbfnEV12WKJn0Vm5Ce5Li6b8_JnGeohGf0UFzNSVjBbpkL8sXeIpuUkoiLCHmg329zyWj9_E2qHmbhrcXgHCpsKoHgqRI-fOp4m2tG84pSXBwcfu-NPiM2cGvg3h1dNCjJ0KCbwc1ToK3FBy4r3axecf1gDF-VKaT4Ti8nobyFJ4pcT5_hWqOrILsVglpqkhgbH9KdTxfW"/>
<span class="text-2xl font-bold tracking-tighter text-slate-50">TechStore</span>
</div>
<!-- Desktop Nav -->
 <div class="hidden md:flex items-center gap-8 font-inter tracking-tight text-sm font-medium"></div>
<div class="hidden md:flex items-center gap-8 font-inter tracking-tight text-sm font-medium">
<a class="text-primary font-bold border-b-2 border-primary" href="/admin">Home</a>
<% if(!member) { %>
<a class="text-slate-400 hover:text-slate-100 transition-colors duration-300 font-sans text-sm tracking-tight font-medium" href="/admin/signup">Signup</a>
<a class="text-slate-400 hover:text-slate-100 transition-colors duration-300 font-sans text-sm tracking-tight font-medium" href="/admin/login">Login</a>
</div>
<%} else { %>
<div class="hidden md:flex items-center gap-8 font-inter tracking-tight text-sm font-medium">
<a class="text-slate-400 hover:text-slate-100 transition-colors duration-300 font-sans text-sm tracking-tight font-medium" href="/admin/product/all">Menu</a>
<a class="text-slate-400 hover:text-slate-100 transition-colors duration-300 font-sans text-sm tracking-tight font-medium" href="/admin/user/all">Users</a>
<a class="text-slate-400 hover:text-slate-100 transition-colors duration-300 font-sans text-sm tracking-tight font-medium" href="/admin/logout" onclick="return confirm('Do you want to logout')" >Logout</a>
</div>
<%}%>
</div>
<!-- Mobile Menu Toggle -->
<button class="md:hidden text-white">
<span class="material-symbols-outlined" data-icon="menu">menu</span>
</button>
</div>
</nav>
<!-- Hero Section -->
<section class="relative min-h-screen flex items-center justify-center overflow-hidden hero-gradient pt-20">
<!-- Particle Effects Decor (Simulated via CSS) -->
<div class="absolute inset-0 opacity-20 pointer-events-none">
<div class="absolute top-1/4 left-1/4 w-2 h-2 bg-blue-400 rounded-full blur-sm"></div>
<div class="absolute top-3/4 left-1/3 w-1 h-1 bg-white rounded-full"></div>
<div class="absolute top-1/2 right-1/4 w-3 h-3 bg-blue-600 rounded-full blur-md"></div>
</div>
<div class="max-w-7xl mx-auto px-6 grid md:grid-cols-2 gap-12 items-center z-10">
<div class="space-y-8">
<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20">
<span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
<span class="text-xs font-bold uppercase tracking-widest text-primary">Precision Engineering</span>
</div>
<h1 class="text-5xl md:text-7xl font-extrabold tracking-tighter text-white leading-none">
                    Welcome to <span class="text-primary-container">TechStore</span>
</h1>
<p class="text-lg md:text-xl text-slate-400 max-w-lg leading-relaxed font-medium">
                    Modern Admin Panel for Managing Products and Users. Elevate your workflow with Kinetic Precision and seamless hardware integration.
                </p>
<div class="flex flex-wrap gap-4 pt-4">
<a class="px-8 py-4 bg-primary text-on-primary font-bold rounded-lg hover:bg-primary-container transition-all duration-300 flex items-center gap-2 group" href="/admin/signup">
                        Signup Now
                        <span class="material-symbols-outlined group-hover:translate-x-1 transition-transform" data-icon="arrow_forward">arrow_forward</span>
</a>
<a class="px-8 py-4 bg-white/5 border border-white/10 text-white font-bold rounded-lg hover:bg-white/10 transition-all duration-300" href="/admin/login">
                        Login
                    </a>
</div>
</div>
<div class="relative flex justify-center items-center">
<!-- 3D Sphere Placeholder -->
<div class="floating-sphere w-64 h-64 md:w-96 md:h-96 rounded-full relative group cursor-crosshair transition-transform duration-700 hover:scale-105">
<div class="absolute inset-0 rounded-full border border-white/10 animate-[spin_10s_linear_infinite]"></div>
<div class="absolute -inset-4 rounded-full border border-blue-500/20 animate-[spin_15s_linear_infinite_reverse]"></div>
<!-- Floating Gadget Icons -->
<div class="absolute -top-8 -right-8 p-4 bg-slate-900/80 backdrop-blur-xl rounded-xl border border-white/10 shadow-2xl">
<span class="material-symbols-outlined text-primary text-3xl" data-icon="laptop_mac">laptop_mac</span>
</div>
<div class="absolute -bottom-4 -left-12 p-4 bg-slate-900/80 backdrop-blur-xl rounded-xl border border-white/10 shadow-2xl">
<span class="material-symbols-outlined text-primary text-3xl" data-icon="smart_watch">watch</span>
</div>
</div>
</div>
</div>
</section>
<!-- Bento Grid Management Showcase -->
<section class="py-24 px-6 max-w-7xl mx-auto">
<div class="mb-16">
<h2 class="text-4xl font-black tracking-tighter text-on-surface mb-4">Enterprise Management</h2>
<div class="h-1.5 w-24 bg-primary rounded-full"></div>
</div>
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 auto-rows-[240px]">
<!-- Product Control -->
<div class="md:col-span-2 bento-card bg-surface-container-low rounded-xl p-8 flex flex-col justify-between overflow-hidden relative">
<div>
<h3 class="text-2xl font-bold text-on-surface mb-2">Inventory Architecture</h3>
<p class="text-on-surface-variant max-w-sm">Manage complex hardware catalogs with granular precision and real-time synchronization.</p>
</div>
<div class="flex gap-4">
