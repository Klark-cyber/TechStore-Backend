<!-- FAB (Suppressed on Landing/Home as per Shell Visibility Rules if necessary, but helpful for primary action) -->
<a class="fixed bottom-8 right-8 w-16 h-16 bg-primary text-on-primary rounded-full shadow-2xl flex items-center justify-center hover:scale-110 active:scale-95 transition-transform z-40" href="/admin/signup">
<span class="material-symbols-outlined text-3xl" data-icon="add">add</span>
</a>
</body></html>