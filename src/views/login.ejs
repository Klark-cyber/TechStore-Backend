<div class="hidden md:flex items-center space-x-8">
<a class="text-slate-400 hover:text-slate-100 transition-colors duration-300 font-sans text-sm tracking-tight font-medium" href="/admin">Home</a>
<a class="text-slate-400 hover:text-slate-100 transition-colors duration-300 font-sans text-sm tracking-tight font-medium" href="/admin/signup">Signup</a>
